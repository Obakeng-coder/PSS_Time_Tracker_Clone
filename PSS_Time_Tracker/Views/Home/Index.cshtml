<!-- No Supervisor Modal -->
<div class="modal fade" id="noSupervisorModal" tabindex="-1" role="dialog" aria-labelledby="noSupervisorModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="noSupervisorModalLabel">Supervisor Not Found</h5>
            </div>
            <div class="modal-body">
                <p>We couldn't find a supervisor assigned to you in Azure Active Directory.</p>
                <p>Please contact your manager to have a supervisor assigned to your account.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" id="goBackButton" style="background-color: #c82333; color: white;" data-bs-dismiss="modal">Go Back</button>
            </div>
        </div>
    </div>
</div>


<style>
    /* Add hover effect to the info boxes */
    .info-box:hover {
        transform: translateY(-5px); /* Move the box up slightly */
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1); /* Add shadow for depth */
        border-color: #c82333 !important; /* Add red border */
        cursor: pointer; /* Change cursor to indicate clickable */
    }

    /* Smooth transition for the button hover */
    .info-box .btn:hover {
        background-color: #a71d2a !important; /* Slightly darker red */
        transition: background-color 0.3s ease;
    }

    .box-image {
        display: block;
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
        max-height: 200px; /* Set your preferred max height */
        width: auto; /* Let the image scale naturally */
        height: auto;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.10);
        object-fit: contain; /* Use 'contain' to avoid cropping, or 'cover' to crop */
    }

    body {
        min-height: 100vh;
        background: linear-gradient(135deg, #c82333 30%, #fff 100%);
    }
</style>

@section Scripts {
    <script>
        // Show Welcome Modal again when Go Back is pressed in No Supervisor Modal
        $('#goBackButton').click(function () {
            var welcomeModal = new bootstrap.Modal(document.getElementById('welcomeModal'), {
                backdrop: 'static',
                keyboard: false
            });
            welcomeModal.show();
        });

        $(document).ready(function () {
            $('#spinnerIcon').hide();

            // Show the welcome modal if flagged
        @if (ViewBag.ShowWelcomePopup != null && (bool)ViewBag.ShowWelcomePopup)
        {
            <text>
                        var welcomeModal = new bootstrap.Modal(document.getElementById('welcomeModal'), {
                            backdrop: 'static',
                            keyboard: false
                        });
                        welcomeModal.show();
            </text>
        }

            // Handle Continue button click
            $('#continueButton').click(function () {
                $('#continueButton').hide();
                $('#spinnerIcon').show();

                $.ajax({
                    url: '@Url.Action("LogUserDetails", "Home")',
                    method: 'GET',
                    success: function (response) {
                        $.get('@Url.Action("CheckSupervisor", "Home")', function(data) {
                            var welcomeModalEl = document.getElementById('welcomeModal');
                            var welcomeModalInstance = bootstrap.Modal.getInstance(welcomeModalEl);
                            welcomeModalInstance.hide();

                            if (data.hasSupervisor === false) {
                                var noSupervisorModal = new bootstrap.Modal(document.getElementById('noSupervisorModal'), {
                                    backdrop: 'static',
                                    keyboard: false
                                });
                                noSupervisorModal.show();
                            }

                            $('#continueButton').show();
                            $('#spinnerIcon').hide();
                        });
                    },
                    error: function (xhr, status, error) {
                        $('#continueButton').show();
                        $('#spinnerIcon').hide();
                    }
                });
            });
        });
    </script>
}
