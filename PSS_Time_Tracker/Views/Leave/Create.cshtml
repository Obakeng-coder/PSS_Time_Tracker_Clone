@model LeaveRequestViewModel
<link rel="manifest" href="~/manifest.json">
<meta name="theme-color" content="#c82333">
@{
    ViewData["Title"] = "Request Time Off";
}

<div class="row">
    <div class="col">
        <div class="card shadow-lg rounded-4 p-4 mt-4 mb-5 form-card">
            <div class="card-header">
                <h5 class="card-title mb-0">Request Time Off: @Model.EmployeeName @Model.EmployeeSurname</h5>
            </div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form method="post" asp-action="Create" id="leaveCreateForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AzureAdUserId" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Department</label>
                            <input class="form-control" readonly value="@(Model.Department ?? "-")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">ID Number</label>
                            <input class="form-control" readonly value="@(Model.IdNumber ?? "-")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Employee Number</label>
                            <input class="form-control" readonly value="@(Model.EmployeeNumber ?? "-")" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" asp-for="LeaveTypeId">Leave Type</label>
                            <select class="form-select" asp-for="LeaveTypeId">
                                <option value="">-- Select Leave Type --</option>
                                @foreach (var lt in Model.LeaveTypeOptions)
                                {
                                    <option value="@lt.Id">@lt.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="OtherLeaveDescription">Other Leave (please specify)</label>
                            <input class="form-control" asp-for="OtherLeaveDescription" placeholder="Only required if you selected 'Other' above" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" asp-for="StartDate">Start Date</label>
                            <input type="date" class="form-control" asp-for="StartDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="EndDate">End Date</label>
                            <input type="date" class="form-control" asp-for="EndDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" asp-for="AddressDuringLeave">Address During Leave</label>
                            <input class="form-control" asp-for="AddressDuringLeave" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="TelephoneNumber">Telephone Number</label>
                            <input class="form-control" asp-for="TelephoneNumber" />
                        </div>

                        <div class="col-12">
                            <label class="form-label" asp-for="Reason">Reason (optional)</label>
                            <textarea class="form-control" rows="3" asp-for="Reason"></textarea>
                        </div>

                        @if (Model.RemainingBalance.HasValue)
                        {
                            <div class="col-12">
                                <div class="alert alert-info mb-0">Remaining balance for this leave type: <strong>@Model.RemainingBalance</strong> day(s).</div>
                            </div>
                        }

                        <div class="col-12">
                            <hr />
                            <p class="text-muted">I hereby affirm that the information provided in this document is accurate and true to the best of my knowledge.</p>
                            <label class="form-label" asp-for="EmployeeSignature">Signature (type your full name)</label>
                            <input class="form-control" asp-for="EmployeeSignature" style="font-family: 'Brush Script MT', cursive; font-size: 1.3rem;" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-danger btn-lg rounded-3" style="background-color: #c82333; border-color: #bd2130;">
                            Submit Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        min-height: 100vh;
        background: linear-gradient(135deg, #c82333 30%, #fff 100%);
        background-attachment: fixed;
    }

    .form-card {
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
    }
</style>

@section Scripts {
    <script src="~/js/leave-offline.js"></script>
}
