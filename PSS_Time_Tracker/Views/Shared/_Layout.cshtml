@using System.Security.Claims
@using PSS_Time_Tracker
@inject IConfiguration Configuration
@* ------------------------------------------------------------------------------------------------------- *@

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string pageTitle = "Home";
    if (currentController == "TimeTracker" && currentAction == "Create")
    {
        pageTitle = "Capture Your Time";
    }
    else if (currentController == "TimeTracker" && currentAction == "Index")
    {
        pageTitle = "My Timesheet Entries";
    }
    else if (currentController == "Manager")
    {
        pageTitle = "Manager Board";
    }
    else if (currentController == "Admin_Approve_Employee")
    {
        pageTitle = "Approve Employees";
    }
    else if (currentController == "HostCompanies")
    {
        pageTitle = "Host Companies";
    }

    // NEW: Determine if user is in the Manager group
    var managerGroupId = Configuration["ManagerGroupId"] ?? "local-managers";
    bool isManager = User.Claims.Any(c => c.Value == managerGroupId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TymSheet</title>

    <!-- Styles -->
    <link rel="preconnect" href="https://fonts.gstatic.com/">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined|Material+Icons+Two+Tone|Material+Icons+Round|Material+Icons+Sharp" rel="stylesheet">
    <link href="~/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/plugins/perfectscroll/perfect-scrollbar.css" rel="stylesheet">
    <link href="~/assets/plugins/pace/pace.css" rel="stylesheet">
    <link href="~/assets/plugins/highlight/styles/github-gist.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

    <!-- Theme Styles -->
    <link href="~/assets/css/main.min.css" rel="stylesheet">
    <link href="~/assets/css/custom.css" rel="stylesheet">

    @* <link href="~/css/site.css" rel="stylesheet"> *@

    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/images/neptune.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/neptune.png" />
</head>
<body>
    <div class="app align-content-stretch d-flex flex-wrap">
        <div class="app-sidebar">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" class="logo-icon" style="color: #c82333;">TymSheet</a>
            </div>
            @* ------------------------------------------------------------------------------------------------------- *@
            @* Made change here so that Manager features are not visible in side bar *@
            @{
                var debugGroups = User.Claims.Where(c => c.Type == "groups").Select(c => c.Value).ToList();
            }
            <!-- TEMP DEBUG: Shows your Azure AD groups -->
            <ul style="color: red; font-size: small;">
                @foreach (var g in debugGroups)
                {
                    <li>@g</li>
                }
            </ul>
            @* ------------------------------------------------------------------------------------------------------- *@

            <div class="app-menu">
                <ul class="accordion-menu">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="sidebar-title">
                            Time Sheet Management
                        </li>
                        <li class="@(currentController == "TimeTracker" && currentAction == "Create" ? "active" : "")">
                            <a asp-area="" asp-controller="TimeTracker" asp-action="Create">
                                <img src="~/assets/images/icon5.png" alt="Icon" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;" />
                                Capture Your Timesheet
                            </a>
                        </li>
                        <li class="@(currentController == "TimeTracker" && currentAction == "Index" ? "active" : "")">
                            <a asp-area="" asp-controller="TimeTracker" asp-action="Index">
                                <img src="~/assets/images/icon4.png" alt="Icon" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;" />
                                Track Your Time
                            </a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a asp-controller="Account" asp-action="Login">
                                <img src="~/assets/images/icon5.png" alt="Icon" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;" />
                                Capture Your Timesheet
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Account" asp-action="Login">
                                <img src="~/assets/images/icon4.png" alt="Icon" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;" />
                                Track Your Time
                            </a>
                        </li>
                    }

                    @* Only show Manager section if user is authenticated AND in the manager group *@
                    @if (isManager == true )
                    {
                        <li class="sidebar-title">
                            Managerial Privileges
                        </li>
                        <li class="menu-item-has-children">
                            <a href="#" class="menu-item-has-children" onclick="toggleSubmenu(this)">
                                <img src="~/assets/images/icon6.png" alt="Icon" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;" />
                                Manager Board
                                <i class="material-icons has-sub-menu" style="float: right;">keyboard_arrow_right</i>
                            </a>
                            <ul class="sub-menu">
                                <li class="@(currentController == "Manager" && currentAction == "Index" ? "active" : "")">
                                    <a asp-area="" asp-controller="Manager" asp-action="Index">Employee Timesheets</a>
                                </li>
                                <li class="@(currentController == "Admin_Approve_Employee" && currentAction == "Index" ? "active" : "")">
                                    <a asp-area="" asp-controller="Admin_Approve_Employee" asp-action="Index">Approve Employees</a>
                                </li>
                                <li class="@(currentController == "HostCompanies" && currentAction == "Index" ? "active" : "")">
                                    <a asp-area="" asp-controller="HostCompanies" asp-action="Index">Host Companies</a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div> <!-- .app-menu -->

            <div style="position: absolute; bottom: 20px; left: 0; width: 100%; text-align: center;">
                <img src="~/assets/images/Logo1.png" alt="Logo" style="max-width: 80%; height: auto;" />
            </div>
        </div> <!-- .app-sidebar -->


        <div class="app-container">
            <div class="search">
                <form>
                    <input class="form-control" type="text" placeholder="Type here..." aria-label="Search">
                </form>
                <a href="#" class="toggle-search"><i class="material-icons">close</i></a>
            </div>

            <div class="custom-navbar">
                <div class="custom-navbar-left">
                    <!-- Hamburger button (visible on mobile) -->
                    <button class="hamburger" id="hamburgerBtn" type="button" aria-label="Open menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <span class="custom-navbar-page-title">@pageTitle</span>
                </div>
                <div class="custom-navbar-right">
                    <div class="custom-navbar-notifications">
                        <div class="custom-navbar-dropdown" id="customNotificationsDropdownMenu" style="display:none;">
                            <div class="custom-navbar-dropdown-header">Notifications</div>
                            <div class="custom-navbar-dropdown-list">
                                <div class="custom-navbar-dropdown-item">
                                    <div class="notifications-dropdown-item-image">
                                        <span class="notifications-badge bg-danger text-white">
                                            <i class="material-icons-outlined">alarm</i>
                                        </span>
                                    </div>
                                    <div class="notifications-dropdown-item-text">
                                        <p class="bold-notifications-text">Reminder: Ensure all weekly timesheets have been submitted every Friday before the end of the day.</p>
                                    </div>
                                </div>
                                <div class="custom-navbar-dropdown-item">
                                    <div class="notifications-dropdown-item-image">
                                        <span class="notifications-badge bg-warning text-white">
                                            <i class="material-icons-outlined">error_outline</i>
                                        </span>
                                    </div>
                                    <div class="notifications-dropdown-item-text">
                                        <p class="bold-notifications-text">If you’ve missed a timesheet entry for last week. Admin approval is required to enter data for the current week.</p>
                                    </div>
                                </div>
                                <div class="custom-navbar-dropdown-item">
                                    <div class="notifications-dropdown-item-image">
                                        <span class="notifications-badge bg-info text-white">
                                            <i class="material-icons-outlined">business</i>
                                        </span>
                                    </div>
                                    <div class="notifications-dropdown-item-text">
                                        <p class="bold-notifications-text">Worked for multiple Host Companies today? Check the box and select all applicable companies from the dropdown.</p>
                                    </div>
                                </div>
                                <div class="custom-navbar-dropdown-item">
                                    <div class="notifications-dropdown-item-image">
                                        <span class="notifications-badge bg-success text-white">
                                            <i class="material-icons-outlined">event</i>
                                        </span>
                                    </div>
                                    <div class="notifications-dropdown-item-text">
                                        <p class="bold-notifications-text">If today is a public holiday and you're not working, check the "Is Today a Public Holiday?" box and choose the date of the public holiday and hit save.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <span class="custom-navbar-user">Hello, @User.Claims.FirstOrDefault(c => c.Type == "name")?.Value</span>
                        <form method="post" asp-controller="Account" asp-action="SignOut" style="display:inline;">
                            <button type="submit" class="custom-navbar-btn">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="custom-navbar-link">Log In</a>
                    }
                </div>

                <!-- Mobile menu (hidden by default) -->
                <nav class="mobile-menu" id="mobileMenu">
                    <ul>
                        <li><a asp-controller="TimeTracker" asp-action="Create">Capture Your Timesheet</a></li>
                        <li><a asp-controller="TimeTracker" asp-action="Index">Track Your Time</a></li>
                        @* Show Manager Board in mobile menu ONLY if manager *@
                        @if (isManager == true)
                        {
                            <li style="padding: 0.75rem 1.5rem 0.25rem 1.5rem; text-align:left; font-weight:700; color:#c82333; font-size:1.1rem; background:#f8f9fa; border-top:1px solid #eee;">
                                Manager Board
                            </li>
                            <li><a asp-controller="Manager" asp-action="Index">Employee Timesheets</a></li>
                            <li><a asp-controller="Admin_Approve_Employee" asp-action="Index">Approve Employees</a></li>
                            <li><a asp-controller="HostCompanies" asp-action="Index">Host Companies</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li>
                                <form method="post" asp-controller="Account" asp-action="SignOut" style="display:inline;">
                                    <button type="submit" class="custom-navbar-btn w-100">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a asp-controller="Account" asp-action="Login" class="custom-navbar-link">Log In</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>


            <div class="app-content">
                <div class="content-wrapper">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Javascripts -->
    <script src="~/assets/plugins/jquery/jquery-3.5.1.min.js"></script>
    <script src="~/assets/plugins/bootstrap/js/popper.min.js"></script>
    <script src="~/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/assets/plugins/perfectscroll/perfect-scrollbar.min.js"></script>
    <script src="~/assets/plugins/pace/pace.min.js"></script>
    <script src="~/assets/plugins/highlight/highlight.pack.js"></script>
    <script src="~/assets/plugins/lightbox/fslightbox.js"></script>
    <script src="~/assets/js/main.min.js"></script>
    <script src="~/assets/js/custom.js"></script>
    <script src="~/assets/js/pages/lightbox.js"></script>
    <script src="~/js/momentjs.min.js"></script>

    <style>
        input:focus,
        textarea:focus,
        select:focus {
            border-color: #c82333 !important;
            box-shadow: 0 0 0 0.2rem rgba(200, 35, 51, 0.25) !important;
            outline: none !important;
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: #c82333 !important;
            box-shadow: 0 0 0 0.2rem rgba(200, 35, 51, 0.25) !important;
            outline: none !important;
        }

        /* Add custom hover color for sidebar */
        .app-sidebar .app-menu ul li a:hover,
        .app-sidebar .app-menu ul li a:focus,
        .app-sidebar .app-menu ul li.active > a,
        .app-sidebar .app-menu ul li a:hover .material-icons-two-tone,
        .app-sidebar .app-menu ul li a:focus .material-icons-two-tone,
        .app-sidebar .app-menu ul li.active > a .material-icons-two-tone {
            color: #c82333 !important;
        }

        .app-sidebar .app-menu ul li ul.sub-menu li a:hover,
        .app-sidebar .app-menu ul li ul.sub-menu li a:focus {
            color: #c82333 !important;
        }

        .app-sidebar .app-menu ul li a:hover i,
        .app-sidebar .app-menu ul li a:focus i,
        .app-sidebar .app-menu ul li.active > a i {
            color: #c82333 !important;
        }

        .custom-navbar {
            height: 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            border-bottom: 2px solid #c82333;
            padding: 0.5rem 2rem;
            font-family: 'Poppins', 'Montserrat', sans-serif;
            z-index: 1000;
        }

        .custom-navbar-left, .custom-navbar-right {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .custom-navbar-brand {
            font-weight: 700;
            color: #c82333;
            text-decoration: none;
            font-size: 1.3rem;
            margin-right: 2rem;
        }

        .custom-navbar-link {
            color: #333;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

            .custom-navbar-link:hover, .custom-navbar-link:focus {
                color: #c82333;
            }

        .custom-navbar-user {
            margin-right: 1rem;
            color: #333;
            font-weight: 500;
        }

        .custom-navbar-btn {
            background: #c82333;
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 0.3rem 1rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

            .custom-navbar-btn:hover {
                background: #a71d2a;
            }

        .custom-navbar-notifications {
            position: relative;
        }

        .custom-navbar-page-title {
            font-size: 1.75rem;
            font-weight: bold;
            color: #000000;
            margin-right: 2rem;
            letter-spacing: 0.5px;
        }

        @@media (max-width: 1468px) {
            .app-sidebar {
                display: none !important;
            }

            .app-container {
                width: 100% !important;
                margin-left: 0 !important;
            }
        }

        .hamburger {
            display: none;
            flex-direction: column;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            margin-left: 1rem;
            z-index: 1101;
        }

            .hamburger span {
                display: block;
                height: 4px;
                width: 100%;
                background: #c82333;
                margin: 4px 0;
                border-radius: 2px;
                transition: 0.3s;
            }

            .hamburger.open span:nth-child(1) {
                transform: translateY(8px) rotate(45deg);
            }

            .hamburger.open span:nth-child(2) {
                opacity: 0;
            }

            .hamburger.open span:nth-child(3) {
                transform: translateY(-8px) rotate(-45deg);
            }

        .mobile-menu {
            display: none;
            position: fixed;
            top: 90px;
            right: 0;
            left: 0;
            background: #fff;
            z-index: 1100;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            padding: 1.5rem 0;
        }

            .mobile-menu ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .mobile-menu li {
                margin: 0.5rem 0;
                text-align: center;
            }

            .mobile-menu a, .mobile-menu button {
                color: #c82333;
                font-weight: 600;
                text-decoration: none;
                font-size: 1.1rem;
                background: none;
                border: none;
                padding: 0.5rem 1.5rem;
                width: 100%;
                display: inline-block;
            }

                .mobile-menu a:hover, .mobile-menu button:hover {
                    background: #f8d7da;
                    color: #a71d2a;
                    border-radius: 5px;
                }

        @@media (max-width: 1200px) {
            .hamburger {
                display: flex;
            }

            .custom-navbar-right, .app-sidebar {
                display: none !important;
            }

            .mobile-menu {
                display: none;
            }

                .mobile-menu.open {
                    display: block;
                }
        }
    </style>

    <script>
        function toggleSubmenu(element) {
            const parentLi = element.parentElement;
            parentLi.classList.toggle('active');
            document.querySelectorAll('.menu-item-has-children').forEach(item => {
                if (item !== parentLi && item.classList.contains('active')) {
                    item.classList.remove('active');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const hamburgerBtn = document.getElementById('hamburgerBtn');
            const mobileMenu = document.getElementById('mobileMenu');

            hamburgerBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                mobileMenu.classList.toggle('open');
                hamburgerBtn.classList.toggle('open');
            });

            document.addEventListener('click', function (e) {
                if (!mobileMenu.contains(e.target) && !hamburgerBtn.contains(e.target)) {
                    mobileMenu.classList.remove('open');
                    hamburgerBtn.classList.remove('open');
                }
            });

            mobileMenu.querySelectorAll('a,button').forEach(function (el) {
                el.addEventListener('click', function () {
                    mobileMenu.classList.remove('open');
                    hamburgerBtn.classList.remove('open');
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>