@model IEnumerable<TimeSheetRecorder.Models.TimeTrackerModel>
@using PSS_Time_Tracker.Services
<link href="~/assets/css/custom.css" rel="stylesheet">
@{
    ViewData["Title"] = "My Timesheet Entries";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool hasPrevious = ViewBag.HasPrevious ?? false;
    bool hasNext = ViewBag.HasNext ?? false;
    string startDate = ViewBag.StartDate;
    string endDate = ViewBag.EndDate;

    var userNameRaw = User.Claims.FirstOrDefault(c => c.Type == "name")?.Value;
    var userName = userNameRaw?.Split('|')[0].Trim();

    // Only populated once the employee has filtered to a specific week (see
    // TimeTrackerController.Index) - drives the Timesheet Gaps panel below.
    var dayResolutions = ViewBag.DayResolutions as List<DayResolution>;
    var myTrueGaps = dayResolutions?.Where(d => d.Kind == DayResolutionKind.TrueGap).ToList()
        ?? new List<DayResolution>();
    var myPending = dayResolutions?.Where(d => d.Kind == DayResolutionKind.PendingConfirmation).ToList()
        ?? new List<DayResolution>();

    @functions {
        // Converts decimal hours (e.g., 7.63) to "7 Hours 38 Minutes"
        public string FormatHours(double totalHours)
        {
            int hours = (int)totalHours;
            int minutes = (int)Math.Round((totalHours - hours) * 60);
            return $"{hours} Hrs {minutes:D2} Mins";
        }
    }
}

<div class="row">
    <div class="col">
        <div class="card shadow-lg rounded-4 p-4 mt-4 mb-5 form-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5 class="card-title mb-0">@($"{userName ?? "User"}'s Timesheet Entries")</h5>
                @if (User.Identity.IsAuthenticated)
                {
                    <div>
                        @if (ViewBag.ShowReportButton == true)
                        {
                            <button id="generateReportBtn" class="btn btn-success mr-2">Generate Weekly Report</button>
                        }
                        <a asp-action="Create" class="btn btn-secondary">Add New Time Entry</a>

                        <button id="toggleFilterBtn" class="btn btn-info" style="background-color: #c82333; border-color: #c82333; color: white;"
                                onmouseover="this.style.backgroundColor='#a81d2b'"
                                onmouseout="this.style.backgroundColor='#c82333'"
                                onmousedown="this.style.backgroundColor='#8e1925'"
                                onmouseup="this.style.backgroundColor='#a81d2b'">
                            Hide Filter
                        </button>
                    </div>
                }
            </div>

            <div class="card-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="alert alert-info" role="alert">
                        <h4>You are not logged in yet.</h4>
                        <p>Please log in to view your timesheet data.</p>
                    </div>
                }
                else
                {
                    <!-- Date Filter Form -->
                    <div id="filterCard" class="row mb-3">
                        <div class="col-md-12">
                            <form asp-action="Index" method="get" class="form-inline">
                                <div class="form-group mr-2">
                                    <label for="startDate" class="mr-2">Start Date:</label>
                                    <input type="date" class="form-control" id="startDate" name="startDate"
                                           value="@(ViewBag.StartDate ?? "")">
                                </div>
                                <div class="form-group mr-2">
                                    <label for="endDate" class="mr-2">End Date:</label>
                                    <input type="date" class="form-control" id="endDate" name="endDate"
                                           value="@(ViewBag.EndDate ?? "")">
                                </div>
                                <input type="hidden" name="page" value="1" />
                                <br />
                              
                                <button type="submit" class="btn btn-primary mr-2" style="background-color: #c82333; border-color: #c82333;"
                                        onmouseover="this.style.backgroundColor='#a81d2b'"
                                        onmouseout="this.style.backgroundColor='#c82333'"
                                        onmousedown="this.style.backgroundColor='#8e1925'"
                                        onmouseup="this.style.backgroundColor='#a81d2b'">
                                    Filter
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">Reset</a>
                            </form>
                        </div>
                    </div>

                    @if (dayResolutions != null && (myTrueGaps.Any() || myPending.Any()))
                    {
                   
                        <div class="card mb-3">
                            <div class="card-header"><strong>Timesheet Gaps This Week</strong></div>
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var gap in myTrueGaps)
                                        {
                                            <tr class="table-danger">
                                                <td>@gap.Date.ToString("yyyy-MM-dd")</td>
                                                <td>Unresolved Gap</td>
                                                <td>
                                                    <form asp-action="RequestGapResolution" asp-controller="TimeTracker" method="post" class="d-flex gap-1 align-items-center flex-wrap">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="date" value="@gap.Date.ToString("yyyy-MM-dd")" />
                                                        <select name="method" class="form-select form-select-sm" style="width:auto;">
                                                            <option value="Holiday">Holiday</option>
                                                            <option value="RetroactiveLeave">Leave</option>
                                                            <option value="UnpaidAbsence">Absent</option>
                                                        </select>
                                                        <input type="text" name="notes" class="form-control form-control-sm" style="width:160px;" placeholder="Notes (optional)" maxlength="200" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Submit</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var gap in myPending)
                                        {
                                            <tr class="table-warning">
                                                <td>@gap.Date.ToString("yyyy-MM-dd")</td>
                                                <td>Awaiting your manager's confirmation (@gap.Note)</td>
                                                <td></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    if (!Model.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            <h4>No timesheet entries found.</h4>
                            <p>You don't have any timesheet entries.</p>
                        </div>
                    }
                    else
                    {
                        <h2>My Timesheet Entries</h2>
                        <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Employee Full Name</th>
                                    @* <th>Supervisor</th> *@
                                    <th>Work Location</th>
                                    <th>Date Of Entry</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Total Hours Worked</th>
                                    <th>Daily Task</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.EmployeeName @item.EmployeeSurname</td>
                                        @* <td>@item.SupervisorFullName</td> *@
                                        <td>@item.WorkLocation</td>
                                        <td>@item.DateOfEntry.ToString("yyyy-MM-dd")</td>
                                        <td>@item.StartTime.ToString("HH:mm")</td>
                                        <td>@item.EndTime.ToString("HH:mm")</td>
                                        <td>@FormatHours(item.TotalHrsWorked)</td>
                                        <td>
                                            @foreach (var task in (item.DailyTask ?? "").Split(';'))
                                            {
                                                if (!string.IsNullOrWhiteSpace(task))
                                                {
                                                    <div>@task.Trim()</div>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsFlaggedForReview)
                                            {
                                                <span class="badge bg-warning text-dark" title="@item.FlagReason">&#9888; Flagged</span>
                                            }
                                            <a asp-action="Edit" asp-route-id="@item.TimeTrackerId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>

                        <!-- Pagination controls -->
                        <nav aria-label="Timesheet pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(!hasPrevious ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-startDate="@startDate"
                                       asp-route-endDate="@endDate">Previous</a>
                                </li>

                                @{
                                    // Calculate the range of pages to show (5 at a time)
                                    int startPage = Math.Max(1, currentPage - 2);
                                    int endPage = Math.Min(totalPages, startPage + 4);

                                    // Adjust if we're at the beginning or end
                                    if (endPage - startPage < 4 && totalPages > 5)
                                    {
                                        if (currentPage < 3)
                                        {
                                            endPage = Math.Min(5, totalPages);
                                        }
                                        else if (currentPage > totalPages - 2)
                                        {
                                            startPage = Math.Max(1, totalPages - 4);
                                        }
                                    }

                                    // Always show first page if not in current range
                                    if (startPage > 1)
                                    {
                                        <li class="page-item @(1 == currentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-page="1"
                                               asp-route-startDate="@startDate"
                                               asp-route-endDate="@endDate"
                                               style="color: #c82333;">1</a>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }

                                    // Show the calculated page range
                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-page="@i"
                                               asp-route-startDate="@startDate"
                                               asp-route-endDate="@endDate"
                                               style="color: #c82333;">@i</a>
                                        </li>
                                    }

                                    // Always show last page if not in current range
                                    if (endPage < totalPages)
                                    {
                                        if (endPage < totalPages - 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        <li class="page-item @(totalPages == currentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-page="@totalPages"
                                               asp-route-startDate="@startDate"
                                               asp-route-endDate="@endDate"
                                               style="color: #c82333;">@totalPages</a>
                                        </li>
                                    }
                                }

                                <li class="page-item @(!hasNext ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-startDate="@startDate"
                                       asp-route-endDate="@endDate">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>


<!-- Dedicated antiforgery token for the report-generation POST below - not scraped from an
     unrelated form on the page (e.g. the layout's logout form), which was fragile. -->
<form id="reportAntiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleFilterBtn = document.getElementById('toggleFilterBtn');
            const filterCard = document.getElementById('filterCard');
            const generateReportBtn = document.getElementById('generateReportBtn');

            // Filter toggle logic (unchanged)
            if (toggleFilterBtn && filterCard) {
                const filterVisible = localStorage.getItem('filterVisibleTimesheet');
                if (filterVisible === 'false') {
                    filterCard.style.display = 'none';
                    toggleFilterBtn.textContent = 'Show Filter';
                } else {
                    filterCard.style.display = 'block';
                    toggleFilterBtn.textContent = 'Hide Filter';
                }

                toggleFilterBtn.addEventListener('click', function() {
                    if (filterCard.style.display === 'none') {
                        filterCard.style.display = 'block';
                        toggleFilterBtn.textContent = 'Hide Filter';
                        localStorage.setItem('filterVisibleTimesheet', 'true');
                    } else {
                        filterCard.style.display = 'none';
                        toggleFilterBtn.textContent = 'Show Filter';
                        localStorage.setItem('filterVisibleTimesheet', 'false');
                    }
                });
            }

            // Every daily entry is already signed at submission time (see the Employee Signature
            // field on the Log Time Entry form), so generating the weekly report no longer needs its
            // own separate "type your signature" step - it's just the date range now. The server still
            // re-checks that every day in the range is actually signed before producing the PDF.
            if (generateReportBtn) {
                generateReportBtn.addEventListener('click', function(e) {
                    e.preventDefault();

                    const startDate = document.getElementById('startDate').value;
                    const endDate = document.getElementById('endDate').value;

                    // Fail fast client-side too, rather than round-tripping a request the server
                    // will just reject - this is what was silently producing a 0001-01-01 PDF before.
                    if (!startDate || !endDate) {
                        alert('Please filter to a complete Monday-Friday week before generating a report.');
                        return;
                    }

                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/TimeTracker/GenerateWeeklyReport';

                    // Dedicated token rendered specifically for this form (see #reportAntiForgeryForm
                    // above) - not scraped from an unrelated form elsewhere on the page.
                    var token = document.querySelector('#reportAntiForgeryForm input[name="__RequestVerificationToken"]').value;
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);

                    var startDateInput = document.createElement('input');
                    startDateInput.type = 'hidden';
                    startDateInput.name = 'startDate';
                    startDateInput.value = startDate;
                    form.appendChild(startDateInput);

                    var endDateInput = document.createElement('input');
                    endDateInput.type = 'hidden';
                    endDateInput.name = 'endDate';
                    endDateInput.value = endDate;
                    form.appendChild(endDateInput);

                    document.body.appendChild(form);
                    form.submit();
                });
            }
        });
    </script>
}

<style>
    body {
        min-height: 100vh;
        width: 100vw;
        background: linear-gradient(135deg, #c82333 30%, #fff 100%);
        background-attachment: fixed;
        background-repeat: no-repeat;
    }

    .form-card {
        max-width: 1250px;
        margin-left: auto;
        margin-right: auto;
        width: 100%;
    }

    /* Responsive table container */
.table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

/* Optional: Make table font smaller and reduce padding on small screens */
@@media (max-width: 768px) {
    .table thead th,
    .table tbody td {
        font-size: 0.95rem;
        padding: 0.4rem 0.5rem;
        white-space: nowrap;
    }
    .form-card {
        padding: 0.5rem !important;
    }
}
</style>