@model TimeSheetRecorder.Models.ViewModels.TimeTrackerViewModel

@{
    ViewData["Title"] = "Log Time Entry";
    var userNameRaw = User.Claims.FirstOrDefault(c => c.Type == "name")?.Value;
    var userName = userNameRaw?.Split('|')[0].Trim();
}

<div class="card shadow-lg rounded-4 p-4 mb-5 form-card">
    <h3 class="mb-4" style="color: #000000; margin-top: 0; margin-bottom: 0;">
        Log Your Time: @(userName ?? "User")
    </h3>
    <div class="card-body">
        <form asp-action="Create" method="post" id="timeEntryForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="AzureAdUserId" />

            <!-- Hidden fields to always submit HostCompanyName and DailyTask -->
            <input type="hidden" asp-for="HostCompanyName" id="HostCompanyNameHidden" />
            <input type="hidden" asp-for="DailyTask" id="DailyTaskHidden" />


            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Employee Name</label>
                    <input asp-for="EmployeeName" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Employee Surname</label>
                    <input asp-for="EmployeeSurname" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Job Title</label>
                    <input asp-for="JobTitle" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Supervisor</label>
                    <input asp-for="SupervisorFullName" class="form-control" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="TimeSheetMonth" class="form-label">Current Month</label>
                    <input asp-for="TimeSheetMonth" class="form-control" readonly />
                    <span asp-validation-for="TimeSheetMonth" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Host Company Name</label>
                        <div class="form-check">
                            <input class="form-check-input custom-red" type="checkbox" id="multiHostCheckbox" />
                            <label class="form-check-label" for="multiHostCheckbox">
                                Have you worked for multiple Host Companies today?
                            </label>
                        </div>
                    </div>

                    <div id="hostCompanySingle">
                        <select asp-for="HostCompanyName" class="form-select" asp-items="@(new SelectList(Model.HostCompanyOptions))">
                            <option value="">-- Select Host Company --</option>
                        </select>
                        <span asp-validation-for="HostCompanyName" class="text-danger"></span>
                    </div>

                    <div id="hostCompanyMultiple" style="display:none;">
                        <select id="multiHostSelect" class="form-select">
                            <option value="">-- Select Host Company --</option>
                            @foreach (var company in Model.HostCompanyOptions)
                            {
                                <option value="@company">@company</option>
                            }
                        </select>
                        <div id="selectedCompanies" class="mt-2">
                            <!-- Selected companies will appear here -->
                        </div>
                        <!-- Hidden input to store selected companies as CSV -->
                        <input type="hidden" name="SelectedHostCompanies" id="SelectedHostCompanies" />
                    </div>
                </div>



                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="DateOfEntry" class="form-label mb-0">Date Of Entry</label>
                        <div class="form-check d-flex align-items-center gap-1">
                            <input asp-for="IsPublicHoliday" class="form-check-input custom-red" type="checkbox" id="IsPublicHoliday" />

                            <label class="form-check-label" for="IsPublicHoliday">
                                Is Today a Public Holiday?
                            </label>
                        </div>
                    </div>
                    <input asp-for="DateOfEntry" type="date" class="form-control" />
                    <span asp-validation-for="DateOfEntry" class="text-danger"></span>
                </div>



                <div class="col-md-6">
                    <label class="form-label">Total Hours Worked</label>
                    <input asp-for="TotalHrsWorkedDisplay" id="TotalHrsWorkedDisplay" type="text" class="form-control" readonly />
                    <input type="hidden" asp-for="TotalHrsWorked" id="TotalHrsWorked" />
                </div>

                <div class="col-md-6">
                    <label asp-for="StartTime" class="form-label">Start Time</label>
                    <input asp-for="StartTime" type="time" class="form-control" id="StartTime" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndTime" class="form-label">End Time</label>
                    <input asp-for="EndTime" type="time" class="form-control" id="EndTime" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <div class="col-12" id="dailyTaskSingle">
                    <label asp-for="DailyTask" class="form-label">Daily Task</label>
                    <textarea asp-for="DailyTask" class="form-control" rows="4" maxlength="100"
                              oninput="updateCharacterCount(this)"></textarea>
                    <small class="text-muted float-end"><span id="charCount">0</span>/100 characters</small>
                    <span asp-validation-for="DailyTask" class="text-danger"></span>
                </div>
                <div class="col-12" id="dailyTaskMultiple" style="display:none;">
                    <label class="form-label">Daily Task(s) per Host Company</label>
                    <div id="multiDailyTasks"></div>
                </div>

            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-danger btn-lg rounded-3" id="submitButton" style="min-width: 150px; background-color: #c82333; border-color: #bd2130;">
                    <span id="submitText">Save Time Entry</span>
                    <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>


            </div>
        </form>
    </div>


    <!-- Modal Popup for Error Message -->
    <div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="errorModalLabel">Timesheet Error</h5>

                </div>

                <div class="modal-body">
                    You have missed submitting timesheets for the previous week (@TempData["MissedWeekStart"] - @TempData["MissedWeekEnd"]). Please request admin approval to proceed.
                </div>
                <div class="modal-footer d-flex justify-content-end" id="errorActionArea">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" id="closeErrorModalButton">Close</button>

                    <form asp-action="RequestAdminApproval" asp-controller="TimeTracker" method="post" id="approvalForm">
                        <button type="submit" class="btn btn-red" id="approvalButton">Request Admin Approval</button>
                    </form>


                    <div class="spinner-border ms-2" role="status" id="errorSpinnerIcon" style="display: none; color: #c82333;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Popup for Invalid Time Range -->
    <div class="modal fade" id="invalidTimeRangeModal" tabindex="-1" role="dialog" aria-labelledby="invalidTimeRangeModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="invalidTimeRangeModalLabel">Invalid Time Entry</h5>
                </div>
                <div class="modal-body">
                    <p>End Time cannot be earlier than Start Time. Please correct your time entry.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" id="closeInvalidTimeRangeModalButton">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Green Toast Message -->
    <div class="toast align-items-center text-white bg-success border-0 position-fixed bottom-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true" id="approvalToast">
        <div class="d-flex">
            <div class="toast-body">
                Admin approval request sent successfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>


    <!-- Modal Popup for Duplicate Date Error -->
    <div class="modal fade" id="duplicateDateModal" tabindex="-1" role="dialog" aria-labelledby="duplicateDateModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ">
                    <h5 class="modal-title" id="duplicateDateModalLabel">Duplicate Timesheet Entry</h5>
                </div>
                <div class="modal-body">
                    <p>A timesheet for this date has already been submitted. Please check your existing entries before submitting again.</p>

                    @if (TempData["DuplicateDateError"] != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @TempData["DuplicateDateError"]
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>



    <!-- Modal Popup for Validation Errors -->
    <div class="modal fade" id="validationErrorModal" tabindex="-1" role="dialog" aria-labelledby="validationErrorModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="validationErrorModalLabel">Missing Required Information</h5>

                </div>
                <div class="modal-body">
                    <p>Please fill in the following required fields:</p>
                    <ul id="validationErrorsList"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary">Close</button>
                </div>

            </div>
        </div>
    </div>

</div>


<!-- Modal Popup for Rejected Approval -->
<div class="modal fade" id="rejectedModal" tabindex="-1" role="dialog" aria-labelledby="rejectedModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rejectedModalLabel">Admin Approval Rejected</h5>
            </div>
            <div class="modal-body" id="rejectedModalBody">
                <!-- Message will be set by JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" id="closeRejectedModalButton">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Popup for Already Requested Approval -->
<div class="modal fade" id="alreadyRequestedModal" tabindex="-1" role="dialog" aria-labelledby="alreadyRequestedModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alreadyRequestedModalLabel">Admin Approval Already Requested</h5>
            </div>
            <div class="modal-body" id="alreadyRequestedModalBody">
                <!-- Message will be set by JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" id="closeAlreadyRequestedModalButton">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")


    <script>

                        // Show --:-- as a visual placeholder for time fields
                        function setTimePlaceholders() {
                            // If empty, show --:-- as a faded overlay
                            ['#StartTime', '#EndTime'].forEach(function (selector) {
                                var $input = $(selector);
                                if (!$input.val()) {
                                    $input.addClass('time-placeholder');
                                }
                                $input.on('input', function () {
                                    if ($input.val()) {
                                        $input.removeClass('time-placeholder');
                                    } else {
                                        $input.addClass('time-placeholder');
                                    }
                                });
                            });
                        }

                        setTimePlaceholders();



                $(document).ready(function () {
                    // Store selected companies in an array
                    var selectedCompanies = [];

                    // --- Keep hidden fields in sync ---
                    function updateHiddenFields() {
                        if ($('#multiHostCheckbox').is(':checked')) {
                            // Multi mode: set hidden fields from selected companies and daily tasks
                            $('#HostCompanyNameHidden').val(selectedCompanies.join(', '));
                            var dailyTasks = [];
                            selectedCompanies.forEach(function (company) {
                                var safeId = company.replace(/[^a-zA-Z0-9]/g, '_');
                                var task = $('#DailyTask_' + safeId).val() || '';
                                if (task.trim() !== '') {
                                    dailyTasks.push(company + ': ' + task.trim());
                                }
                            });
                            $('#DailyTaskHidden').val(dailyTasks.join('; '));
                        } else {
                            // Single mode: set hidden fields from visible fields
                            $('#HostCompanyNameHidden').val($('#HostCompanyName').val());
                            $('#DailyTaskHidden').val($('#DailyTask').val());
                        }
                    }

                    // Toggle between single and multiple host company selection
                    $('#multiHostCheckbox').on('change', function () {
                        if ($(this).is(':checked')) {
                            $('#hostCompanySingle').hide();
                            $('#hostCompanyMultiple').show();
                            $('#dailyTaskSingle').hide();
                            $('#dailyTaskMultiple').show();
                            renderMultiDailyTasks();
                        } else {
                            $('#hostCompanyMultiple').hide();
                            $('#hostCompanySingle').show();
                            $('#dailyTaskMultiple').hide();
                            $('#dailyTaskSingle').show();
                            // Clear selections when switching back to single mode
                            selectedCompanies = [];
                            updateSelectedCompanies();
                        }
                        updateHiddenFields();
                    });

                    // Add company
                    $('#multiHostSelect').on('change', function () {
                        var val = $(this).val();
                        if (val && !selectedCompanies.includes(val)) {
                            selectedCompanies.push(val);
                            updateSelectedCompanies();
                            renderMultiDailyTasks();
                        }
                        $(this).val('');
                        updateHiddenFields();
                    });

                    // Remove company
                    $('#selectedCompanies').on('click', '.remove-company', function (e) {
                        e.preventDefault();
                        var val = $(this).data('value');
                        selectedCompanies = selectedCompanies.filter(function (c) { return c !== val; });
                        updateSelectedCompanies();
                        renderMultiDailyTasks();
                        updateHiddenFields();
                    });

                    function updateSelectedCompanies() {
                        var html = '';
                        selectedCompanies.forEach(function (company) {
                            html += '<span class="badge me-1 mb-1" style="background-color: #c82333; color: white;">' + company +
                                ' <a href="javascript:void(0);" class="text-white ms-1 remove-company" data-value="' + company + '">&times;</a></span>';
                        });
                        $('#selectedCompanies').html(html);
                        $('#SelectedHostCompanies').val(selectedCompanies.join(','));
                    }

                    // Render daily task textareas for each selected company
                    function renderMultiDailyTasks() {
                        var html = '';
                        selectedCompanies.forEach(function (company, idx) {
                            var safeId = company.replace(/[^a-zA-Z0-9]/g, '_');
                            html += `
                                <div class="mb-2" data-company="${company}">
                                    <label class="form-label">${company} Daily Task</label>
                                    <textarea name="DailyTasksPerCompany[${company}]" id="DailyTask_${safeId}" class="form-control multi-daily-task" rows="2" maxlength="100"></textarea>
                                    <small class="text-muted float-end"><span class="charCount">0</span>/100 characters</small>
                                </div>
                            `;
                        });
                        $('#multiDailyTasks').html(html);
                        updateHiddenFields();
                    }

                    // Character count for dynamic textareas
                    $(document).on('input', '.multi-daily-task', function () {
                        var charCount = $(this).val().length;
                        $(this).siblings('.text-muted').find('.charCount').text(charCount);
                        updateHiddenFields();
                    });

                    // Keep hidden fields in sync with single fields
                    $('#HostCompanyName, #DailyTask').on('input change', updateHiddenFields);

                    // On form submit, ensure hidden input is updated
                    $('form').on('submit', function () {
                        $('#SelectedHostCompanies').val(selectedCompanies.join(','));
                        updateHiddenFields();
                    });

                    // Initialize character count for single daily task on page load
                    const initialText = $('#DailyTask').val() || '';
                    $('#charCount').text(initialText.length);

                    // Modal and other utility functions
                    $('#errorModal').on('shown.bs.modal', function () {
                        $('#closeErrorModalButton').show();
                        $('#approvalButton').show();
                        $('#errorSpinnerIcon').hide();
                    });


                    //close modal popups
                    $('#alreadyRequestedModal .btn-secondary').on('click', function() {
                    $('#alreadyRequestedModal').modal('hide');
                    });

                    $('#errorModal .btn-secondary, #validationErrorModal .btn-secondary, #duplicateDateModal .btn-secondary, #rejectedModal .btn-secondary').on('click', function() {
                        $(this).closest('.modal').modal('hide');
                    });

                          $('#closeInvalidTimeRangeModalButton').on('click', function () {
            $('#invalidTimeRangeModal').modal('hide');

            // Clear Start and End Time fields
            $('#StartTime').val('').trigger('input');
            $('#EndTime').val('').trigger('input');

            // Optionally clear total hours fields
            $('#TotalHrsWorkedDisplay').val("0 Hours 0 Minutes");
            $('#TotalHrsWorked').val("0:00");
        });



           function updateTotalHours() {
            var start = $('#StartTime').val();
            var end = $('#EndTime').val();

            if (start && end) {
                var startParts = start.split(':');
                var endParts = end.split(':');

                var startTime = new Date(2000, 0, 1, startParts[0], startParts[1]);
                var endTime = new Date(2000, 0, 1, endParts[0], endParts[1]);

                if (endTime <= startTime) {
                    // Trigger the invalid time modal
                    $('#invalidTimeRangeModal').modal('show');

                    $('#TotalHrsWorkedDisplay').val("0 Hours 0 Minutes");
                    $('#TotalHrsWorked').val("0:00");
                    return;
                }

                var diffMs = (endTime - startTime) - (30 * 60 * 1000); // Subtract 30 min break
                diffMs = Math.max(0, diffMs); // Ensure not negative

                var hours = Math.floor(diffMs / (1000 * 60 * 60));
                var minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

                // Format for display
                $('#TotalHrsWorkedDisplay').val(`${hours} Hours ${minutes} Minutes`);

                // Format for database submission (HH:mm)
                $('#TotalHrsWorked').val(`${hours}:${minutes < 10 ? "0" + minutes : minutes}`);
            }
        }




                    function updateMonthFromDate() {
                        const selectedDate = new Date($('#DateOfEntry').val());
                        if (!isNaN(selectedDate.getTime())) {
                            const monthName = selectedDate.toLocaleString('default', { month: 'long' });
                            const year = selectedDate.getFullYear();
                            $('#TimeSheetMonth').val(`${monthName} ${year}`);
                        }
                    }

                    function setWeekBoundaries() {
                        const today = new Date();
                        const dayOfWeek = today.getDay();
                        const mondayOffset = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
                        const firstDayOfWeek = new Date(today);
                        firstDayOfWeek.setDate(today.getDate() + mondayOffset);
                        const lastDayOfWeek = new Date(firstDayOfWeek);
                        lastDayOfWeek.setDate(firstDayOfWeek.getDate() + 4);

                        const minDate = firstDayOfWeek.toISOString().split('T')[0];
                        const maxDate = lastDayOfWeek.toISOString().split('T')[0];

                        const datePicker = document.getElementById("DateOfEntry");
                        if (datePicker) {
                            datePicker.setAttribute("min", minDate);
                            datePicker.setAttribute("max", maxDate);
                            if (today.getDay() === 0 || today.getDay() === 6) {
                                datePicker.value = maxDate;
                            }
                        }
                        updateMonthFromDate();
                    }

                    $('#StartTime, #EndTime').on('change', updateTotalHours);
                    $('#DateOfEntry').on('change', updateMonthFromDate);
                    setWeekBoundaries();
                    updateTotalHours();
                    updateMonthFromDate();

            $('#timeEntryForm').submit(function(e) {
                e.preventDefault();

            // Custom validation: Start and End Time are 00:00 and not public holiday
            var startTime = $('#StartTime').val();
            var endTime = $('#EndTime').val();
            var isPublicHoliday = $('#IsPublicHoliday').is(':checked');

            if (startTime === "00:00" && endTime === "00:00" && !isPublicHoliday) {
                // Show validation error modal with custom message
                var errorsList = $('#validationErrorsList');
                errorsList.empty();
                errorsList.append('<li>Start Time and End Time cannot both be 00:00 unless it is a Public Holiday.</li>');
                $('#validationErrorModal').modal('show');
                $('#submitText').removeClass('d-none');
                $('#submitSpinner').addClass('d-none');
                $('#submitButton').prop('disabled', false)
                    .css('min-width', '120px');
                return; // Prevent AJAX submit
            }


                        $('#submitText').addClass('d-none');
                        $('#submitSpinner').removeClass('d-none')
                            .css({'display': 'inline-block', 'vertical-align': 'middle'});
                        $('#submitButton').prop('disabled', true)
                            .css('min-width', $('#submitButton').outerWidth() + 'px');

                        $.ajax({
                            url: $(this).attr('action'),
                            type: $(this).attr('method'),
                            data: $(this).serialize(),
                            dataType: 'json',
                            success: function(response) {
                                if (response.showValidationError) {
                                    var errorsList = $('#validationErrorsList');
                                    errorsList.empty();
                                    response.errorMessages.forEach(function(error) {
                                        errorsList.append('<li>' + error + '</li>');
                                    });
                                    $('#validationErrorModal').modal('show');
                                } else if (response.showModal) {
                                    var startDate = response.missedWeekStart || '@TempData["MissedWeekStart"]';
                                    var endDate = response.missedWeekEnd || '@TempData["MissedWeekEnd"]';
                                    $('#errorModal .modal-body').text(
                                        'You have missed submitting timesheets for the previous week (' +
                                        startDate + ' - ' + endDate + '). Please request admin approval to proceed.'
                                    );
                                    $('#errorModal').modal({
                                        backdrop: 'static',
                                        keyboard: false
                                    }).modal('show');
                                } else if (response.showDuplicateModal) {
                                    var errorMessage = '@TempData["DuplicateDateError"]';
                                    if (errorMessage) {
                                        $('#duplicateDateModal .modal-body').text(errorMessage);
                                    }
                                    $('#duplicateDateModal').modal('show');
                                } else if (response.redirectUrl) {
                                    window.location.href = response.redirectUrl;
                                    return;
                                } else if (response.showRejectedModal) {
                                    $('#rejectedModalBody').text(response.rejectedMessage);
                                    $('#rejectedModal').modal('show');
                                }
                                        else if (response.showAlreadyRequestedModal) {
                    $('#alreadyRequestedModalBody').text(response.alreadyRequestedMessage);
                    $('#alreadyRequestedModal').modal('show');
                }
                                $('#submitText').removeClass('d-none');
                                $('#submitSpinner').addClass('d-none');
                                $('#submitButton').prop('disabled', false)
                                    .css('min-width', '120px');
                            }
                        });
                    });

                    // Handle admin approval request
                    $('#errorModal form').submit(function(e) {
                        e.preventDefault();
                        $('#approvalButton').hide();
                        $('#closeErrorModalButton').hide();
                        $('#errorSpinnerIcon').show();

                        $.ajax({
                            url: $(this).attr('action'),
                            type: $(this).attr('method'),
                            data: $(this).serialize(),
                            success: function(response) {
                                $('#errorModal').modal('hide');
                                $('#HostCompanyName').val('');
                                $('#StartTime').val('');
                                $('#EndTime').val('');
                                $('#TotalHrsWorked').val('0');
                                $('#DailyTask').val('');
                                var today = new Date().toISOString().split('T')[0];
                                $('#DateOfEntry').val(today);
                                updateMonthFromDate();
                                var toast = new bootstrap.Toast(document.getElementById('approvalToast'));
                                toast.show();
                                $('#submitText').removeClass('d-none');
                                $('#submitSpinner').addClass('d-none');
                                $('#submitButton').prop('disabled', false)
                                    .css('min-width', '120px');
                            },
                            error: function(xhr, status, error) {
                                console.error(error);
                                alert('Failed to request admin approval. Please try again.');
                            },
                            complete: function() {
                                $('#approvalButton').show();
                                $('#closeErrorModalButton').show();
                                $('#errorSpinnerIcon').hide();
                            }
                        });
                    });
                });

                function updateCharacterCount(textarea) {
                    const charCount = textarea.value.length;
                    document.getElementById('charCount').textContent = charCount;
                    const counter = document.getElementById('charCount');
                    if (charCount > 40) {
                        counter.classList.add('text-danger');
                    } else {
                        counter.classList.remove('text-danger');
                    }
                }

                        // Add this to your $(document).ready function
                $('#IsPublicHoliday').on('change', function() {
                    if ($(this).is(':checked')) {
                        // Set default values for public holiday
                        $('#HostCompanyName').val('PSS').prop('disabled', true);
                        $('#TotalHrsWorked').val('8').prop('readonly', true);
                        $('#StartTime').val('00:00').prop('disabled', true);
                        $('#EndTime').val('00:00').prop('disabled', true);
                        $('#DailyTask').val('Public Holiday').prop('readonly', true);

                        // For multi-host company mode
                        if ($('#multiHostCheckbox').is(':checked')) {
                            $('#multiHostCheckbox').prop('checked', false).trigger('change');
                        }
                    } else {
                        // Re-enable fields when unchecked
                        $('#HostCompanyName').val('').prop('disabled', false);
                        $('#TotalHrsWorked').val('0').prop('readonly', false);
                        $('#StartTime').val('').prop('disabled', false);
                        $('#EndTime').val('').prop('disabled', false);
                        $('#DailyTask').val('').prop('readonly', false);
                    }
                });

                        $(document).ready(function () {
                    // Function to handle enabling/disabling the multi host checkbox
                    function toggleMultiHostCheckbox() {
                        if ($('#IsPublicHoliday').is(':checked')) {
                            $('#multiHostCheckbox').prop('checked', false).prop('disabled', true).trigger('change');
                        } else {
                            $('#multiHostCheckbox').prop('disabled', false);
                        }
                    }

                    // Initial check on page load
                    toggleMultiHostCheckbox();

                    // Handle toggle when the IsPublicHoliday checkbox changes
                    $('#IsPublicHoliday').on('change', function () {
                        toggleMultiHostCheckbox();
                    });
                });
    </script>
}

