@model PSS_Time_Tracker.Models.HostCompany
@{
    ViewData["Title"] = "Add Host Company";
}

<div class="row">
    <div class="col">
        <div class="card shadow-lg rounded-4 p-4 mt-4 mb-5 form-card">
            <div class="card-header">
                <h5 class="card-title mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="hostCompanyForm">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary" id="submitBtn" style="background-color: #c82333; border-color: #c82333; color: white;">Add</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('hostCompanyForm').addEventListener('submit', function () {
            document.getElementById('submitBtn').disabled = true;
        });
    </script>
}


<style>
    body {
        min-height: 100vh;
        width: 100vw;
        background: linear-gradient(135deg, #c82333 30%, #fff 100%);
        background-attachment: fixed;
        background-repeat: no-repeat;
    }

    .form-card {
        max-width: 1250px;
        margin-left: auto;
        margin-right: auto;
        width: 100%;
    }
</style>