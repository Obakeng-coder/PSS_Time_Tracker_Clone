@model IEnumerable<PSS_Time_Tracker.Models.HostCompany>
@{
	ViewData["Title"] = "Host Companies";
	int currentPage = ViewBag.CurrentPage ?? 1;
	int totalPages = ViewBag.TotalPages ?? 1;
	bool hasPrevious = ViewBag.HasPrevious ?? false;
	bool hasNext = ViewBag.HasNext ?? false;
}

<div class="row">
	<div class="col">
		<div class="card shadow-lg rounded-4 p-4 mt-4 mb-5 form-card">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h5 class="card-title mb-0">Host Companies</h5>
				<a asp-action="Create" class="btn btn-secondary" style="background-color: #c82333; border-color: #c82333; color: white;">Add New Host Company</a>
			</div>
			<div class="card-body">
				<div class="mb-3">
					<form method="get" asp-action="Index" id="searchForm">
						<div class="input-group">
							<input type="text" name="searchTerm" class="form-control" placeholder="Search by company name..."
								   value="@ViewBag.SearchTerm" />
							<button class="btn btn-outline-secondary" type="submit">Search</button>
							<button class="btn btn-outline-secondary" type="button" onclick="resetSearch()">Reset</button>
						</div>
					</form>
				</div>

				@if (!Model.Any())
				{
					<div class="alert alert-info" role="alert">
						<h4>No host companies found.</h4>
						<p>No host companies match your search criteria.</p>
					</div>
				}
				else
				{
					<table class="table table-bordered table-striped mb-0">
						<thead>
							<tr>
								<th>Name</th>
								<th style="width: 180px;">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var company in Model)
							{
								<tr>
									<td>@company.Name</td>
									<td>
										<a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-secondary">Edit</a>
										<form asp-action="Delete" asp-route-id="@company.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this company?');">
											<button type="submit" class="btn btn-sm btn-danger">Delete</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
					<br />
					<!-- Pagination controls -->
					<nav aria-label="Host Companies pagination">
						<ul class="pagination justify-content-center">
							<li class="page-item @(!hasPrevious ? "disabled" : "")">
								<a class="page-link"
								   asp-action="Index"
								   asp-route-page="@(currentPage - 1)"
								   asp-route-searchTerm="@ViewBag.SearchTerm">Previous</a>
							</li>

							@{
								int startPage = Math.Max(1, currentPage - 2);
								int endPage = Math.Min(totalPages, startPage + 4);

								if (endPage - startPage < 4 && totalPages > 5)
								{
									if (currentPage < 3)
									{
										endPage = Math.Min(5, totalPages);
									}
									else if (currentPage > totalPages - 2)
									{
										startPage = Math.Max(1, totalPages - 4);
									}
								}

								if (startPage > 1)
								{
									<li class="page-item @(1 == currentPage ? "active" : "")">
										<a class="page-link"
										   asp-action="Index"
										   asp-route-page="1"
										   asp-route-searchTerm="@ViewBag.SearchTerm"
										   style="color: #c82333;">1</a>
									</li>
									if (startPage > 2)
									{
										<li class="page-item disabled">
											<span class="page-link">...</span>
										</li>
									}
								}

								for (int i = startPage; i <= endPage; i++)
								{
									<li class="page-item @(i == currentPage ? "active" : "")">
										<a class="page-link"
										   asp-action="Index"
										   asp-route-page="@i"
										   asp-route-searchTerm="@ViewBag.SearchTerm"
										   style="color: #c82333;">@i</a>
									</li>
								}

								if (endPage < totalPages)
								{
									if (endPage < totalPages - 1)
									{
										<li class="page-item disabled">
											<span class="page-link">...</span>
										</li>
									}
									<li class="page-item @(totalPages == currentPage ? "active" : "")">
										<a class="page-link"
										   asp-action="Index"
										   asp-route-page="@totalPages"
										   asp-route-searchTerm="@ViewBag.SearchTerm"
										   style="color: #c82333;">@totalPages</a>
									</li>
								}
							}

							<li class="page-item @(!hasNext ? "disabled" : "")">
								<a class="page-link"
								   asp-action="Index"
								   asp-route-page="@(currentPage + 1)"
								   asp-route-searchTerm="@ViewBag.SearchTerm">Next</a>
							</li>
						</ul>
					</nav>
				}
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		function resetSearch() {
			document.querySelector('input[name="searchTerm"]').value = '';
			document.getElementById('searchForm').submit();
		}
	</script>
}

<style>
	body {
		min-height: 100vh;
		width: 100vw;
		background: linear-gradient(135deg, #c82333 30%, #fff 100%);
		background-attachment: fixed;
		background-repeat: no-repeat;
	}

	.form-card {
		max-width: 1250px;
		margin-left: auto;
		margin-right: auto;
		width: 100%;
	}
</style>