@model object
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - HourTrack</title>
    <link href="~/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #c82333 30%, #fff 100%);
            font-family: 'Segoe UI', sans-serif;
        }
        .login-card {
            background: #fff;
            border-radius: 10px;
            padding: 2.5rem;
            max-width: 420px;
            width: 100%;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .login-card h3 { color: #c82333; margin-bottom: 0.25rem; }
        .login-card p.subtitle { color: #666; margin-bottom: 1.5rem; }
        .btn-microsoft {
            background: #fff; color: #5e5e5e; border: 1px solid #8c8c8c; border-radius: 4px;
            padding: 0.6rem 1.25rem; font-weight: 600; display: flex; align-items: center;
            justify-content: center; gap: 0.6rem;
        }
        .btn-microsoft:hover { background: #f3f3f3; color: #5e5e5e; }
        .ms-logo { width: 20px; height: 20px; flex: 0 0 auto; }
    </style>
</head>
<body>
    <div class="login-card">
        <h3>HourTrack</h3>
        <p class="subtitle">Sign in with your Providence Software Microsoft account.</p>

        @if (!string.IsNullOrEmpty(ViewBag.AuthError as string))
        {
            <div class="alert alert-danger py-2">@ViewBag.AuthError</div>
        }

        @if (ViewBag.AzureAdConfigured)
        {
            <a class="btn btn-microsoft w-100" asp-controller="Account" asp-action="AzureLogin" asp-route-returnUrl="@ViewBag.ReturnUrl">
                <svg class="ms-logo" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg">
                    <rect x="1" y="1" width="9" height="9" fill="#f25022" /><rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef" /><rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                </svg>
                Sign in with Microsoft
            </a>
        }
        else
        {
            <div class="alert alert-warning py-2 mb-0">
                Azure AD isn't configured (AzureAd:ClientId/TenantId are missing). There's no way to
                sign in until that's set up - contact IT.
            </div>
        }
    </div>
</body>
</html>
