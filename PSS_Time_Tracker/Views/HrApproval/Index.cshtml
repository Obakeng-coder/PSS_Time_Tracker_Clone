@model IEnumerable<LeaveRequest>
@using PSS_Time_Tracker.Models
@{
    ViewData["Title"] = "HR Board";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool hasPrevious = ViewBag.HasPrevious ?? false;
    bool hasNext = ViewBag.HasNext ?? false;
    var employees = ViewBag.Employees as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="row">
    <div class="col">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <div class="card shadow-lg rounded-4 p-4 mt-4 mb-5 form-card">
            <div class="card-header">
                <h5 class="card-title mb-0">HR Board</h5>
                <p class="text-muted mb-0 small">Leave requests already recommended by their line manager - HR decides pay status, then Payroll captures it against the employee's balance.</p>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">No leave requests currently need HR/Payroll action.</div>
                }
                else
                {
                    @foreach (var lr in Model)
                    {
                        var employeeName = employees.TryGetValue(lr.AzureAdUserId, out var n) ? n : lr.AzureAdUserId;
                        <div class="border rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between flex-wrap">
                                <div>
                                    <strong>@employeeName</strong> &middot; @(lr.LeaveType?.Name ?? "-")
                                    @(string.IsNullOrWhiteSpace(lr.OtherLeaveDescription) ? "" : $"({lr.OtherLeaveDescription})")
                                    &middot; @lr.StartDate.ToString("yyyy-MM-dd") to @lr.EndDate.ToString("yyyy-MM-dd")
                                    &middot; @lr.TotalDays day(s)
                                </div>
                                <span class="badge bg-secondary align-self-start">@lr.Status</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lr.Reason))
                            {
                                <div class="text-muted small mt-1">Reason: @lr.Reason</div>
                            }
                            <div class="text-muted small mt-1">
                                Manager recommendation: @lr.ManagerRecommendation
                                @(string.IsNullOrWhiteSpace(lr.ManagerRemarks) ? "" : $"- {lr.ManagerRemarks}")
                            </div>

                            @if (lr.Status == LeaveRequestStatus.PendingHR)
                            {
                                <form asp-controller="HrApproval" asp-action="HrDecision" method="post" class="mt-3 row g-2 align-items-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@lr.Id" />
                                    <div class="col-md-3">
                                        <label class="form-label small mb-0">Decision</label>
                                        <select name="decision" class="form-select form-select-sm">
                                            <option value="@HrDecisionType.ApprovedWithPay">Approved with Pay</option>
                                            <option value="@HrDecisionType.ApprovedWithoutPay">Approved without Pay</option>
                                            <option value="@HrDecisionType.NotApproved">Not Approved</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small mb-0">Remarks</label>
                                        <input name="remarks" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small mb-0">Signature</label>
                                        <input name="signature" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-sm w-100" style="background-color:#c82333; color:white;">Submit</button>
                                    </div>
                                </form>
                            }
                            else if (lr.Status == LeaveRequestStatus.PendingPayrollCapture)
                            {
                                <form asp-controller="HrApproval" asp-action="PayrollCapture" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@lr.Id" />
                                    <div class="small text-muted mb-2">HR decision: @lr.HrDecision @(string.IsNullOrWhiteSpace(lr.HrRemarks) ? "" : $"- {lr.HrRemarks}")</div>
                                    <button type="submit" class="btn btn-sm" style="background-color:#c82333; color:white;">Capture &amp; Complete</button>
                                </form>
                            }
                        </div>
                    }

                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(!hasPrevious ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">Page @currentPage of @Math.Max(totalPages, 1)</span></li>
                            <li class="page-item @(!hasNext ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

<style>
    body {
        min-height: 100vh;
        background: linear-gradient(135deg, #c82333 30%, #fff 100%);
        background-attachment: fixed;
    }

    .form-card {
        max-width: 1100px;
        margin-left: auto;
        margin-right: auto;
    }
</style>
