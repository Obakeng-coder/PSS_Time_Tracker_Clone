@model IEnumerable<PSS_Time_Tracker.Models.UserAccount>

@{
    ViewData["Title"] = "Employee Approval Requests";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool hasPrevious = ViewBag.HasPrevious ?? false;
    bool hasNext = ViewBag.HasNext ?? false;
}

<div class="row">
    <div class="col">
        <div class="card shadow-lg rounded-4 p-4 mt-4 mb-5 form-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1);"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1);"></button>
                    </div>
                }

                <div class="mb-3">
                    <form method="get" asp-action="Index" id="searchForm">
                        <div class="input-group">
                            <input type="text" name="searchTerm" class="form-control" placeholder="Search by employee name..."
                                   value="@ViewBag.SearchTerm" />
                            <button class="btn btn-outline-secondary" type="submit">Search</button>
                            <button class="btn btn-outline-secondary" type="button" onclick="resetSearch()">Reset</button>
                        </div>
                    </form>
                </div>

          @if (!Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        <img src="~/assets/images/emptyBox.png" alt="No requests" style="width:180px; margin-bottom: 12px;" />
        <h4 class="mt-2">No approval requests found.</h4>
        <p>No pending approval requests from your staff</p>
    </div>
}
                else
                {
                    <table class="table table-striped" id="employeeTable">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Email</th>
                                <th>Job Title</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.EmployeeName @user.EmployeeSurname</td>
                                    <td>@user.Email</td>
                                    <td>@user.JobTitle</td>
                                    <td>
                                        <form asp-action="ApproveUser" method="post" class="approve-form" style="display: inline;">
                                            <input type="hidden" name="azureAdUserId" value="@user.AzureAdUserId" />
                                            <button type="submit" class="btn btn-approve">
                                                <span class="approve-text">Approve</span>
                                                <span class="loading-content d-none">
                                                    <span class="approving-text">Approving...</span>
                                                    <span class="spinner-border spinner-border-sm ms-1" role="status" aria-hidden="true"></span>
                                                </span>
                                            </button>
                                        </form>

                                        <form asp-action="RejectUser" method="post" class="reject-form" style="display: inline; margin-left: 5px;">
                                            <input type="hidden" name="azureAdUserId" value="@user.AzureAdUserId" />
                                            <button type="submit" class="btn btn-reject">
                                                <span class="reject-text">Reject</span>
                                                <span class="loading-content d-none">
                                                    <span class="rejecting-text">Rejecting...</span>
                                                    <span class="spinner-border spinner-border-sm ms-1" role="status" aria-hidden="true"></span>
                                                </span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination controls -->
                    <!-- Pagination controls -->
                    <nav aria-label="Approval pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(!hasPrevious ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-searchTerm="@ViewBag.SearchTerm">Previous</a>
                            </li>

                            @{
                                // Calculate the range of pages to show (5 at a time)
                                int startPage = Math.Max(1, currentPage - 2);
                                int endPage = Math.Min(totalPages, startPage + 4);

                                // Adjust if we're at the beginning or end
                                if (endPage - startPage < 4 && totalPages > 5)
                                {
                                    if (currentPage < 3)
                                    {
                                        endPage = Math.Min(5, totalPages);
                                    }
                                    else if (currentPage > totalPages - 2)
                                    {
                                        startPage = Math.Max(1, totalPages - 4);
                                    }
                                }

                                // Always show first page if not in current range
                                if (startPage > 1)
                                {
                                    <li class="page-item @(1 == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="1"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           style="color: #c82333;">1</a>
                                    </li>
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                // Show the calculated page range
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@i"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           style="color: #c82333;">@i</a>
                                    </li>
                                }

                                // Always show last page if not in current range
                                if (endPage < totalPages)
                                {
                                    if (endPage < totalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item @(totalPages == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@totalPages"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           style="color: #c82333;">@totalPages</a>
                                    </li>
                                }
                            }

                            <li class="page-item @(!hasNext ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-searchTerm="@ViewBag.SearchTerm">Next</a>
                            </li>
                        </ul>
                    </nav>
                    @* <nav aria-label="Approval pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(!hasPrevious ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-searchTerm="@ViewBag.SearchTerm">Previous</a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-searchTerm="@ViewBag.SearchTerm"
                                       style="color: #c82333;">@i</a>
                                </li>
                            }

                            <li class="page-item @(!hasNext ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-searchTerm="@ViewBag.SearchTerm">Next</a>
                            </li>
                        </ul>
                    </nav> *@
                }
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="approvalToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Initialize toast outside DOMContentLoaded so it's available globally
        const approvalToast = document.getElementById('approvalToast') ? new bootstrap.Toast(document.getElementById('approvalToast')) : null;

        function resetSearch() {
            // Clear the search input
            document.querySelector('input[name="searchTerm"]').value = '';
            // Submit the form
            document.getElementById('searchForm').submit();
        }

        function showToast(message, isSuccess = true, persist = false) {
            if (!approvalToast) return;

            // Set toast color based on success/error
            const toastElement = document.getElementById('approvalToast');
            if (toastElement) {
                toastElement.classList.remove('bg-success', 'bg-danger');
                toastElement.classList.add(isSuccess ? 'bg-success' : 'bg-danger');
            }

            // Set message and show toast
            const toastMessage = document.getElementById('toastMessage');
            if (toastMessage) {
                toastMessage.textContent = message;
                approvalToast.show();

                // If persist is true, don't auto-hide
                if (!persist) {
                    // Auto-hide after 5 seconds
                    setTimeout(() => {
                        approvalToast.hide();
                    }, 5000);
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Check if we need to show a toast from session storage
            const toastMessage = sessionStorage.getItem('toastMessage');
            const toastType = sessionStorage.getItem('toastType');

            if (toastMessage) {
                showToast(toastMessage, toastType === 'success', true);
                // Clear the stored message
                sessionStorage.removeItem('toastMessage');
                sessionStorage.removeItem('toastType');

                // Auto-hide after 5 seconds now that we've shown it
                setTimeout(() => {
                    if (approvalToast) {
                        approvalToast.hide();
                    }
                }, 5000);
            }

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert-success, .alert-danger');
                alerts.forEach(function (alert) {
                    alert.classList.add('fade-out');
                    setTimeout(() => alert.remove(), 500);
                });
            }, 5000);

            // Handle approve/reject form submissions
            document.querySelectorAll('.approve-form, .reject-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    // Get the button and its elements
                    const button = form.querySelector('button[type="submit"]');
                    const isApprove = form.classList.contains('approve-form');
                    const buttonText = button.querySelector(isApprove ? '.approve-text' : '.reject-text');
                    const loadingContent = button.querySelector('.loading-content');
                    const spinner = button.querySelector('.spinner-border');
                    const row = form.closest('tr');

                    // Store original button width to prevent resizing
                    const originalWidth = button.offsetWidth;
                    button.style.width = originalWidth + 'px';

                    // Disable the button and show the loading content
                    button.disabled = true;
                    if (buttonText) buttonText.classList.add('d-none');
                    if (loadingContent) loadingContent.classList.remove('d-none');
                    if (spinner) spinner.classList.remove('d-none');

                    // If this is an Approve form, disable all Reject buttons in the same row
                    if (isApprove) {
                        const rejectButtons = row.querySelectorAll('.reject-form button[type="submit"]');
                        rejectButtons.forEach(rejectBtn => {
                            rejectBtn.disabled = true;
                            rejectBtn.classList.add('disabled');
                            rejectBtn.style.pointerEvents = 'none';
                            rejectBtn.style.opacity = '0.6';
                        });
                    }

                    // Submit the form via fetch API
                    fetch(form.action, {
                        method: form.method,
                        body: new URLSearchParams(new FormData(form)),
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    })
                    .then(response => {
                        if (response.redirected) {
                            // Store the toast message before redirecting
                            sessionStorage.setItem('toastMessage', isApprove ? 'User approved successfully!' : 'User rejected successfully!');
                            sessionStorage.setItem('toastType', isApprove ? 'success' : 'error');
                            window.location.href = response.url;
                        } else {
                            return response.json();
                        }
                    })
                    .then(data => {
                        if (data && data.redirectUrl) {
                            // Store the toast message before redirecting
                            sessionStorage.setItem('toastMessage', isApprove ? 'User approved successfully!' : 'User rejected successfully!');
                            sessionStorage.setItem('toastType', isApprove ? 'success' : 'error');
                            window.location.href = data.redirectUrl;
                        } else {
                            // For non-redirect responses, show toast immediately
                            if (isApprove) {
                                showToast('User approved successfully!');
                            } else {
                                showToast('User rejected successfully!', false);
                            }
                            // Reload after toast is shown
                            setTimeout(() => {
                                window.location.reload();
                            }, 5000);
                        }
                    })
                    .catch(error => {
                        // On error, restore button states
                        button.disabled = false;
                        button.classList.remove('disabled');
                        button.style.pointerEvents = '';
                        button.style.opacity = '';
                        if (buttonText) buttonText.classList.remove('d-none');
                        if (loadingContent) loadingContent.classList.add('d-none');
                        if (spinner) spinner.classList.add('d-none');
                        button.style.width = '';

                        // If this was an Approve form, re-enable Reject buttons in the same row
                        if (isApprove) {
                            const rejectButtons = row.querySelectorAll('.reject-form button[type="submit"]');
                            rejectButtons.forEach(rejectBtn => {
                                rejectBtn.disabled = false;
                                rejectBtn.classList.remove('disabled');
                                rejectBtn.style.pointerEvents = '';
                                rejectBtn.style.opacity = '';
                            });
                        }

                        showToast('An error occurred while processing your request.', false);
                    });
                });
            });

            // Client-side search functionality
            const searchInput = document.getElementById('searchInput');
            const clearSearch = document.getElementById('clearSearch');
            const employeeRows = document.querySelectorAll('.employee-row');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const originalAlert = document.querySelector('.alert-info'); // Original "no records" alert

            function performSearch() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let hasMatches = false;

                // Hide original alert if search is active
                if (searchTerm.length > 0 && originalAlert) {
                    originalAlert.classList.add('d-none');
                }

                employeeRows.forEach(row => {
                    const name = row.getAttribute('data-name');
                    const email = row.getAttribute('data-email');
                    const job = row.getAttribute('data-job');

                    if (name.includes(searchTerm) ||
                        email.includes(searchTerm) ||
                        job.includes(searchTerm)) {
                        row.classList.remove('d-none');
                        hasMatches = true;
                    } else {
                        row.classList.add('d-none');
                    }
                });

                // Show/hide no results message
                if (searchTerm.length > 0 && !hasMatches) {
                    noResultsMessage.classList.remove('d-none');
                } else {
                    noResultsMessage.classList.add('d-none');
                }

                // Show original alert if search is empty and no records exist
                if (searchTerm.length === 0 && originalAlert && employeeRows.length === 0) {
                    originalAlert.classList.remove('d-none');
                }
            }

            // Event listeners
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    performSearch();
                });
            }

            if (clearSearch) {
                clearSearch.addEventListener('click', function () {
                    searchInput.value = '';
                    performSearch();
                    searchInput.focus();
                });
            }

            // Initial focus on search box
            if (searchInput) {
                searchInput.focus();
            }
        });
    </script>
}


<style>
    .fade-out {
        opacity: 0;
        transition: opacity 0.5s ease-out;
    }

    /* Ensure buttons maintain consistent width during loading */
    .btn-sm {
        min-width: 70px;
    }

    /* Style for search box */
    #searchInput {
        max-width: 300px;
    }

    /* Button Base Styles */
    .btn-approve, .btn-reject {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        min-height: 38px;
        transition: all 0.3s ease;
    }

    /* Custom Approve Button */
    .btn-approve {
        background-color: #28a745; /* Green */
        color: white;
        border: none;
        padding: 0.5rem 2.5rem;
        font-size: 0.9rem;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-approve:hover {
            background-color: #218838; /* Darker green */
            transform: scale(1.05);
        }

        .btn-approve:disabled {
            background-color: #94d3a2; /* Light green */
            cursor: not-allowed;
            transform: none;
        }

    /* Custom Reject Button */
    .btn-reject {
        background-color: #dc3545; /* Red */
        color: white;
        border: none;
        padding: 0.5rem 2.5rem;
        font-size: 0.9rem;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-reject:hover {
            background-color: #c82333; /* Darker red */
            transform: scale(1.05);
        }

        .btn-reject:disabled {
            background-color: #f5b7b1; /* Light red */
            cursor: not-allowed;
            transform: none;
        }

    /* Loading State Styles */
    .loading-content {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .approving-text, .rejecting-text {
        font-size: 0.9rem;
    }

    /* Spinner adjustments */
    .spinner-border {
        width: 1rem;
        height: 1rem;
        border-width: 0.15em;
        vertical-align: middle;
    }

    /* Button content transitions */
    .approve-text, .reject-text, .loading-content {
        transition: opacity 0.2s ease;
    }

    /* Table adjustments */
    .table td {
        vertical-align: middle;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .btn-approve, .btn-reject {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }

        .approving-text, .rejecting-text {
            font-size: 0.8rem;
        }

        .spinner-border {
            width: 0.8rem;
            height: 0.8rem;
        }
    }


    

    body {
        min-height: 100vh;
        width: 100vw;
        background: linear-gradient(135deg, #c82333 30%, #fff 100%);
        background-attachment: fixed;
        background-repeat: no-repeat;
    }

    .form-card {
        max-width: 1250px;
        margin-left: auto;
        margin-right: auto;
        width: 100%;
    }
</style>


