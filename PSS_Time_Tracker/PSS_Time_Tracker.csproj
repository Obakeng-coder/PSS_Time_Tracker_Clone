<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows Smart App Control blocks the freshly-built, unsigned native apphost .exe
         that VS's Debug button launches directly. Disabling apphost generation makes VS
         (and dotnet run) launch via the trusted, Microsoft-signed dotnet.exe instead. -->
    <UseAppHost>false</UseAppHost>
    <!-- Lets `dotnet user-secrets` store EmailSettings:ServiceAccountPassword etc. outside the repo
         in Development, instead of appsettings.json in plaintext. ASP.NET Core loads user secrets
         automatically once this is set - see README for the exact command. -->
    <UserSecretsId>b541dafa-80fd-406d-bb77-c98e2cbc5284</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.18" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.18" />
    <PackageReference Include="iTextSharp" Version="5.5.13.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
